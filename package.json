{
  "name": "soc-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade Security Operations Center platform",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules",
    "postinstall": "pnpm --filter @soc/database exec prisma generate"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.7",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "ioredis": "5.11.1",
      "vite": ">=6.4.3",
      "postcss": ">=8.5.10",
      "find-my-way": "^9.7.0",
      "fast-uri@^3": "^3.1.8",
      "fast-uri@^4": "^4.1.5",
      "js-yaml@^4": "^4.3.1",
      "deepmerge-ts@^7": "^8.0.2",
      "nanoid@^3": "^3.3.18",
      "brace-expansion@^1": "^1.1.21",
      "brace-expansion@^2": "^2.1.7",
      "brace-expansion@^5": "^5.0.12",
      "@fastify/busboy@^3": "^3.2.2",
      "@grpc/grpc-js@^1": "^1.14.5",
      "browserslist@^4": "^4.28.7",
      "fast-copy@^4": "^4.1.0",
      "ip-address@^10": "^10.7.1",
      "mysql2@^3": "^3.23.1",
      "source-map-js@^1": "^1.2.2",
      "undici@^8": "^8.10.2",
      "sharp": "^0.35.5",
      "@fastify/static": "^10.1.2"
    }
  }
}
