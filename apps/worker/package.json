{
  "name": "@soc/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./otel/instrumentation.mjs src/index.ts",
    "build": "node ../../packages/config/build-node-app.mjs",
    "start": "node --import ./otel/instrumentation.mjs dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/instrumentation": "7.9.1",
    "@soc/connectors": "workspace:*",
    "@soc/database": "workspace:*",
    "@soc/observability": "workspace:*",
    "bullmq": "^5.81.2",
    "ioredis": "5.11.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@soc/config": "workspace:*",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.17.0",
    "globals": "^17.8.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.6"
  }
}
